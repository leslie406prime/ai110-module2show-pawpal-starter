classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferred_categories
        +list~Pet~ pets
        +add_pet(Pet pet) None
        +get_all_tasks() list~Task~
        +set_available_time(int minutes) None
        +set_preferences(list~str~ categories) None
    }
    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(Task task) None
        +remove_task(Task task) None
        +get_pending_tasks() list~Task~
    }
    class Task {
        +str description
        +str category
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +update_details(str description, str category, int duration_minutes, str priority) None
        +mark_complete() None
    }
    class Scheduler {
        +Owner owner
        +list~Task~ selected_tasks
        +list~Task~ skipped_tasks
        +generate_plan() list~Task~
        +get_total_duration() int
        +explain_plan() str
    }

    Owner "1" --> "0..*" Pet : cares for
    Pet "1" --> "0..*" Task : has
    Scheduler "0..*" --> "1" Owner : plans for
    Scheduler --> Task : selects and orders
